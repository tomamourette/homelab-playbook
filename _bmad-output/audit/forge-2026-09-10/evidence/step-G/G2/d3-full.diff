diff --git a/stacks/infra-core/config/hermes-saply.yml b/stacks/infra-core/config/hermes-saply.yml
new file mode 100644
index 0000000..3b0addb
--- /dev/null
+++ b/stacks/infra-core/config/hermes-saply.yml
@@ -0,0 +1,23 @@
+# Traefik configuration for Hermes webhook listener on ct-saply-ai (192.168.50.164)
+# Pattern follows ai-services.yml for cross-host routing
+# HTTP→HTTPS redirect is handled globally at the entrypoint level in traefik.yml
+
+http:
+  # Services - point to ct-saply-ai
+  services:
+    hermes-saply:
+      loadBalancer:
+        servers:
+          - url: "http://192.168.50.164:8644"
+
+  # Routers - HTTPS only (redirect handled by entrypoint)
+  routers:
+    hermes-saply-secure:
+      entryPoints:
+        - "websecure"
+      rule: "Host(`hermes.bi-services.be`)"
+      service: "hermes-saply"
+      # No Authelia middleware — webhook authenticates via HMAC signature
+      # (X-Hub-Signature-256 validated per-route in hermes-agent gateway).
+      tls:
+        certResolver: letsencrypt
