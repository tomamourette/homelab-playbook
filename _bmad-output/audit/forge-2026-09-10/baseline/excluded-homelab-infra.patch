 #
 # Related: Story 7.11 (LetsEncrypt DNS-01 ACME), Story 7.12 (full vault-backed secret rendering)
 
+# ---------------------------------------------------------------------------
+# Play 1 — operator-workbench credential hygiene.
+#
+# WHY THIS EXISTS. Independent security review of FE2-S05 found LIVE credentials
+# sitting in PLAINTEXT, world-readable, on the operator workbench
+# (ct-dev-homelab). None of them was created by FE2-S05; all of them predate it.
+# The first pass of this play fixed three, and a SECOND review proved that pass
+# too narrow. Both generations are handled below.
+#
+# FOUND BY THE FIRST REVIEW (fixed, and the fixes are kept):
+#   1. /tmp/tfvars.bak.<pid>        — mode 0644, WORLD-READABLE, in shared /tmp
+#                                     on the same machine that holds
+#                                     ansible/.vault_pass and the SSH key.
+#      Origin checked: NOTHING in either repo writes this path (`grep -rn
+#      tfvars.bak` over the whole workspace returns nothing), so it was a
+#      hand-typed `cp terraform.tfvars /tmp/...` — exactly the out-of-IaC
+#      shortcut this estate treats as drift.
+#   2. terraform.tfvars itself      — mode 0644, and its lineinfile `backup:`
+#                                     copies preserve that mode, so every
+#                                     rotation minted another world-readable
+#                                     copy of the live token next to it.
+#   3. ~/.bash_history              — a `curl -H "Authorization: Bearer <tok>"`
+#                                     against Cloudflare's token-verify endpoint.
+#
+# FOUND BY THE SECOND REVIEW — the first pass MISSED these, and said so wrongly:
+#   4. terraform/envs/homelab/terraform-plugin-proxmox.log — 11.7 MB, mode 0644,
+#      holding 6465 cleartext copies of var.pve_token_id and 6409 of
+#      var.pve_token_secret (counted BY VALUE, never printed). Not a stale
+#      artefact: it was REGENERATED by committed configuration on every apply,
+#      including FE2-S05's own. The generator is now off at source
+#      (terraform/envs/homelab/main.tf, pm_log_enable / pm_debug = false); this
+#      play destroys the file that configuration already wrote.
+#   5. VS Code local-history snapshots of terraform.tfvars — four 0644 files
+#      under History/, each byte-identical to the live tfvars for pve_token_id,
+#      pve_token_secret AND dev_vm_password. The first pass filtered history by
+#      the FILENAME of one shell script, so it could only ever match that
+#      script's history and never the tfvars history — the very file its own
+#      comments called out as holding the live token. The sweep below is
+#      RESOURCE-DRIVEN instead: it matches the history index's own "resource"
+#      field against secret-bearing PATH shapes, so a new secret file is covered
+#      the first time VS Code snapshots it, with no list to keep updated.
+#   6. The GENERATOR was left open. The first pass claimed the exposure "cannot
+#      recur" because terraform.tfvars is now 0600. That is false: VS Code local
+#      history writes a fresh 0644 snapshot on every save regardless of the
+#      source file's mode. Shredding snapshots without closing the generator
+#      just resets the clock. The settings task below excludes secret-bearing
+#      paths from local history so no new snapshot is taken.
+#
+# Every check and removal below is VALUE-FREE: it matches on paths and on
+# structural patterns ("Authorization: Bearer", '"resource":"...tfvars"'), never
+# on a secret value. Nothing here reads the vault, so running it cannot leak.
+#
+# Run just this play:
+#   ansible-playbook -i inventories/homelab/hosts.ini \
+#     playbooks/sync-cloudflare-token.yml --tags token-hygiene
+#
+# NOT DONE HERE, and still operator actions — purging copies BOUNDS an exposure,
+# it does not END one. Every credential below was world-readable on a shared
+# machine and must be treated as DISCLOSED:
+#   * vault_cloudflare_api_token — three consumers (terraform.tfvars, Traefik on
+#     ct-docker-01, Caddy on ct-forge-01). Procedure in the comment below.
+#   * pve_token_secret / pve_token_id — the Proxmox API token that Terraform
+#     drives the whole cluster with. Rotate in the Proxmox UI, then re-vault.
+#     This is the LARGER of the two disclosures and it is easy to overlook,
+#     because the review that started this play only named the Cloudflare one.
+#   * dev_vm_password — additionally, it was the SAME string as the one in the
+#     TRACKED terraform.tfvars.example, so it was published in the repository
+#     and remains in git history. The .example now says REPLACE_ME; rotating the
+#     live value is the other half and is not automatable from here.
+# None of these can be minted from this workbench: the vaulted Cloudflare token
+# carries only dns_records:edit / dns_records:read / zone:read, and the Proxmox
+# token cannot mint its own successor.
+- name: Purge plaintext credential spills from the operator workbench
+  hosts: localhost
+  connection: local
+  gather_facts: false
+  tags: [token-hygiene]
+  vars:
+    tf_env_dir: "{{ playbook_dir }}/../../terraform/envs/homelab"
+    tfvars_path: "{{ playbook_dir }}/../../terraform/envs/homelab/terraform.tfvars"
+    vscode_user_dir: "{{ lookup('env', 'HOME') }}/.vscode-server/data/User"
+    vscode_history_dir: "{{ lookup('env', 'HOME') }}/.vscode-server/data/User/History"
+    vscode_settings_path: "{{ lookup('env', 'HOME') }}/.vscode-server/data/User/settings.json"
+    bash_history_path: "{{ lookup('env', 'HOME') }}/.bash_history"
+    workspace_root: "{{ playbook_dir }}/../../.."
+    # GitNexus keeps a local code index per repo. It ingested terraform.tfvars
+    # while that file was still 0644, so the index carries the values verbatim.
+    gitnexus_index_dirs:
+      - "{{ playbook_dir }}/../../../homelab-infra/.gitnexus"
+      - "{{ playbook_dir }}/../../../homelab-apps/.gitnexus"
+      - "{{ playbook_dir }}/../../../homelab-playbook/.gitnexus"
+
+    # Value-free markers. A history line matching any of these is a plaintext
+    # credential spill by construction, whatever the value happens to be.
+    # PYTHON regex, not POSIX/ERE. lineinfile compiles `regexp` with Python's
+    # `re`, where `[[:space:]]` is NOT a whitespace class — it is a character
+    # set containing [ : s p a c e — so `Authorization:[[:space:]]*Bearer`
+    # silently matches NOTHING against `Authorization: Bearer <tok>`. Measured:
+    # the first run of this play reported ok/no-change on a history file that
+    # demonstrably held the line. Use \s. Single-quoted YAML scalars keep the
+    # backslash literal; a `>-` / `|-` block scalar would NOT, which is the same
+    # trap this estate already hit once.
+    secret_history_markers:
+      - 'Authorization:\s*Bearer\s'
+      - 'cloudflare_api_token\s*='
+      - 'CF_DNS_API_TOKEN='
+      - 'CF_TOKEN='
+      - 'pve_token_secret\s*='
+      - 'dev_vm_password\s*='
+
+    # RESOURCE-DRIVEN, not filename-driven. Each History/<hash>/entries.json is
+    # single-line JSON whose "resource" field is the URI of the file the
+    # snapshots belong to, e.g.
+    #   {"version":1,"resource":"vscode-remote://tunnel%2Bct-dev-homelab/.../terraform.tfvars","entries":[...]}
+    # Anchoring every pattern on "resource":" means the match is made against
+    # the INDEXED PATH and never against snapshot contents — so this sweep
+    # cannot itself read, log or diff a secret. Each pattern ends at the closing
+    # quote, so `.env` does not drag in `.env.sample` and `.tfvars` does not
+    # drag in the tracked `terraform.tfvars.example`.
+    secret_resource_patterns:
+      - '.*"resource":"[^"]*\.tfvars".*'
+      - '.*"resource":"[^"]*vault\.ya?ml".*'
+      - '.*"resource":"[^"]*\.env".*'
+      - '.*"resource":"[^"]*/local-secrets/[^"]*".*'
+      - '.*"resource":"[^"]*/secrets/[^"]*".*'
+      - '.*"resource":"[^"]*\.vault_pass".*'
+      - '.*"resource":"[^"]*id_(rsa|ed25519)".*'
+      - '.*"resource":"[^"]*test-cloudflare-token\.sh".*'
+
+    # CLOSING THE GENERATOR. VS Code writes a 0644 local-history snapshot on
+    # every save, whatever the source file's mode — so a 0600 terraform.tfvars
+    # still yields world-readable copies. These globs stop the snapshot being
+    # taken at all. Merged into the user settings rather than written over them,
+    # and it takes effect on the next window reload.
+    localhistory_exclude:
+      "**/*.tfvars": true
+      "**/vault.yml": true
+      "**/vault.yaml": true
+      "**/*.env": true
+      "**/local-secrets/**": true
+      "**/secrets/**": true
+      "**/.vault_pass": true
+      "**/id_rsa": true
+      "**/id_ed25519": true
+
+  tasks:
+
+    - name: Enforce 0600 on terraform.tfvars (it holds the live token in cleartext)
+      ansible.builtin.file:
+        path: "{{ tfvars_path }}"
+        mode: "0600"
+      register: tfvars_mode
+
+    # --- 1. world-readable copies of terraform.tfvars ------------------------
+
+    - name: Find world-readable plaintext spills of the token
+      ansible.builtin.find:
+        paths: "{{ item.path }}"
+        patterns: "{{ item.patterns }}"
+        file_type: file
+        recurse: false
+      loop:
+        # The hand-made /tmp copy the security review found, plus any sibling.
+        - { path: "/tmp", patterns: ["tfvars.bak.*", "terraform.tfvars.bak*"] }
+        # lineinfile `backup:` output — `terraform.tfvars.<pid>.<date>~`.
+        - { path: "{{ tf_env_dir }}", patterns: ["terraform.tfvars.*~", "terraform.tfvars.bak*"] }
+      loop_control:
+        label: "{{ item.path }}"
+      register: token_spills
+
+    - name: Shred and unlink each spill
+      # shred, not `state: absent`: these files are world-readable copies of a
+      # live credential. Best-effort on a CoW filesystem, but strictly better
+      # than an unlink, and it is what the security finding asked for.
+      ansible.builtin.command:
+        argv: [shred, -u, "{{ item.path }}"]
+      loop: "{{ token_spills.results | map(attribute='files') | flatten }}"
+      loop_control:
+        label: "{{ item.path }}"
+      changed_when: true
+
+    # --- 2. the Proxmox provider debug log -----------------------------------
+
+    - name: Find Proxmox provider debug logs inside the Terraform env
+      # Written by pm_log_enable/pm_debug, which are now false in main.tf. This
+      # destroys what the old setting already produced. The find is by NAME, so
+      # it never opens the file and cannot echo a credential.
+      ansible.builtin.find:
+        paths: "{{ tf_env_dir }}"
+        patterns: ["terraform-plugin-proxmox.log", "terraform-plugin-proxmox.log.*"]
+        file_type: file
+        recurse: false
+      register: proxmox_debug_logs
+
+    - name: Report the Proxmox debug logs about to be destroyed (sizes only)
+      ansible.builtin.debug:
+        msg: >-
+          {{ item.path | basename }}: {{ item.size }} bytes, mode {{ item.mode }}
+          — held the live Proxmox API token in cleartext
+      loop: "{{ proxmox_debug_logs.files }}"
+      loop_control:
+        label: "{{ item.path | basename }}"
+
+    - name: Shred the Proxmox provider debug logs
+      ansible.builtin.command:
+        argv: [shred, -u, "{{ item.path }}"]
+      loop: "{{ proxmox_debug_logs.files }}"
+      loop_control:
+        label: "{{ item.path | basename }}"
+      changed_when: true
+
+    # --- 2b. local tool indexes that swallowed the tfvars -------------------
+
+    # FOUND BY SCANNING BY VALUE WITH THE REAL grep. The interactive shell here
+    # aliases `grep` to ugrep, which honours .gitignore — so a by-value sweep run
+    # through the alias silently SKIPS every gitignored file, terraform.tfvars
+    # among them, and reports a reassuring zero. Re-run with /usr/bin/grep and
+    # -a (binary included, not -I), homelab-infra/.gitnexus/lbug turns up: a
+    # 31.8 MB index, mode 0644, holding dev_vm_password and pve_token_id in
+    # cleartext because it indexed terraform.tfvars back when that file was
+    # world-readable too. Gitignored (.gitignore:68) so never committed.
+    #
+    # TIGHTENED, NOT DESTROYED. Shredding a 31 MB code index would break the
+    # operator's GitNexus tooling to win a checkbox; the exposure here is the
+    # world-readable BIT, and 0600 closes it while the index keeps working (it
+    # is owned by, and read by, the same user). Rotating dev_vm_password remains
+    # the real fix and is listed as an operator action above.
+    - name: Find local tool indexes that ingested the tfvars while it was 0644
+      ansible.builtin.find:
+        paths: "{{ gitnexus_index_dirs }}"
+        patterns: ["lbug", "*.db", "meta.json"]
+        file_type: file
+        recurse: false
+      register: gitnexus_indexes
+      failed_when: false
+
+    - name: Take world-readability off those indexes
+      ansible.builtin.file:
+        path: "{{ item.path }}"
+        mode: "0600"
+      loop: "{{ gitnexus_indexes.files | default([]) }}"
+      loop_control:
+        label: "{{ item.path | regex_replace('^.*/homelab/', '') }}"
+
+    # --- 3. VS Code local history, by RESOURCE not by filename ---------------
+
+    - name: Find VS Code local-history indexes for secret-bearing files
+      ansible.builtin.find:
+        paths: "{{ vscode_history_dir }}"
+        patterns: "entries.json"
+        contains: "{{ item }}"
+        file_type: file
+        recurse: true
+      loop: "{{ secret_resource_patterns }}"
+      loop_control:
+        label: "{{ item }}"
+      register: vscode_secret_history
+      failed_when: false
+
+    - name: Collect the snapshot directories to destroy
+      ansible.builtin.set_fact:
+        vscode_secret_history_dirs: >-
+          {{ vscode_secret_history.results
+             | map(attribute='files') | flatten
+             | map(attribute='path') | map('dirname')
+             | unique | sort }}
+
+    - name: Report which snapshot directories are going (paths only, no contents)
+      ansible.builtin.debug:
+        msg: >-
+          {{ item | basename }}:
+          {{ (lookup('file', item ~ '/entries.json') | from_json)['resource'] }}
+      loop: "{{ vscode_secret_history_dirs }}"
+      loop_control:
+        label: "{{ item | basename }}"
+
+    - name: Shred every file inside those snapshot directories
+      ansible.builtin.shell:
+        cmd: |
+          set -euo pipefail
+          d={{ item | quote }}
+          find "$d" -type f -print0 | xargs -0 -r shred -u
+          rmdir "$d"
+        executable: /bin/bash
+      loop: "{{ vscode_secret_history_dirs }}"
+      loop_control:
+        label: "{{ item | basename }}"
+      changed_when: true
+
+    # --- 4. close the generator ----------------------------------------------
+
+    # ansible.cfg sets `become = true` GLOBALLY, so every task in this play runs
+    # as root even though it targets the operator's own home directory. Writing
+    # settings.json without an explicit owner therefore produced a root:root
+    # 0600 file that VS Code — running as the workbench user — could not read,
+    # silently defeating the exclusion it was written to install. Measured, not
+    # theorised: the first run of this task did exactly that. Take the ownership
+    # from the directory VS Code already owns rather than hardcoding a name.
+    - name: Stat the VS Code User directory to learn who owns it
+      ansible.builtin.stat:
+        path: "{{ vscode_user_dir }}"
+      register: vscode_user_dir_stat
+
+    - name: Read the VS Code user settings, if any
+      ansible.builtin.slurp:
+        src: "{{ vscode_settings_path }}"
+      register: vscode_settings_raw
+      failed_when: false
+
+    - name: Assume empty settings until proven parsable
+      ansible.builtin.set_fact:
+        vscode_settings_now: {}
